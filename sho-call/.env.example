# Copy to .env (optional). No secrets are required for local development.
# HTTP/WebSocket server port (Vite dev server proxies /api and /ws here)
PORT=8787
# Vite dev server port
CLIENT_PORT=5174
# SQLite database file (created and migrated automatically)
DATABASE_PATH=./data/sho-call.db
# Allowed browser origins for WebSocket upgrades, comma separated.
# Leave empty to allow same-origin plus the local Vite dev server.
ALLOWED_ORIGINS=
# Set to "true" only behind HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false
# Set to "false" to hide the one-click demo account buttons on the login page.
DEMO_LOGIN=true
